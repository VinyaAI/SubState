# Copy to .env and fill in real values:
#   cp components/cli/.env.example components/cli/.env
#   # or: cp components/cli/.env.example .env   (loaded from cwd)
#
# Already-exported shell env vars win over values in .env.
#
# Sync schema:
#   Prefer: cargo run -p substate-cli -- init
#   Or copy schema.template.yaml → schema.yaml and fill placeholders.
#   Then set SCHEMA_PATH below.
#
# Run:
#   cargo run -p substate-cli -- serve
#
# Debug REPL:
#   cargo run -p substate-cli -- shell

# Required for Postgres sources / `substate init` scan
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Required for serve/shell — sync schema (logical entities + field authority)
# Paths are relative to the process working directory (usually the repo root).
# Generate with `substate init`, or copy schema.template.yaml → schema.yaml.
SCHEMA_PATH=./schema.yaml

# Optional — path to a dotenv file (overrides cwd / components/cli/.env discovery)
# DOTENV_PATH=./components/cli/.env

# Optional — Postgres schema to introspect (default: public)
CDS_SCHEMA=public

# Optional — comma-separated table allowlist; unused under schema mode except warnings
# CDS_TABLES=my_table

# Optional — poll interval in milliseconds if CDC is unavailable (default: 2000)
CDS_POLL_MS=2000

# Optional — postgres follow: auto (default), cdc, or poll
# POSTGRES_FOLLOW=auto

# Required when the schema has a kafka source (comma-separated brokers)
# KAFKA_BROKERS=localhost:9092

# Inspect current CDS: curl http://BIND_ADDR/v1/cds
# Optional — HTTP/WebSocket listen address
# Local: 127.0.0.1:8080 | container: 0.0.0.0:8080
BIND_ADDR=127.0.0.1:8080

# Optional — shared secret for /v1/* (Authorization: Bearer <key> or x-api-key).
# When unset, /v1/* stays open (local-dev only; a warning is logged).
# SUBSTATE_API_KEY=dev-secret

# Optional — CDS / subscription / delta-history snapshot path (default ./substate-snapshot.json)
# SUBSTATE_SNAPSHOT_PATH=./substate-snapshot.json

# Optional — Kafka partition offsets file (default ./substate-kafka-offsets.json)
# SUBSTATE_KAFKA_OFFSETS_PATH=./substate-kafka-offsets.json

# Optional — log level (default: info)
# RUST_LOG=info
